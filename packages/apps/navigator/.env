# root url where .pmtiles are stored, e.g., https://truckermudgeon.github.io
# leave blank to use the host URL of the demo app's webserver.
VITE_TILE_ROOT_URL=

# root url where panorama images are stored, e.g., https://truckermudgeon.github.io
# leave blank to use the host URL of the demo app's webserver.
VITE_PIXEL_ROOT_URL=panos

# navigator api websocket url.
# leave blank to connect to the server that served the app (local network mode).
# the dev server (npm start) uses the value in .env.development instead.
VITE_WS_URL=
# map font glyphs. served by the navigation server from WEB_DIR/fonts so the
# phone never needs internet access. (scripts/veri-uret.sh downloads them.)
VITE_GLYPHS_URL=/fonts/{fontstack}/{range}.pbf
